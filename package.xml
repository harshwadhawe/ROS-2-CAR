<?xml version="1.0"?>
<package format="3">
  <name>pistar_car</name>
  <version>0.1.0</version>
  <description>ROS 2 base stack for the Pi Star Lab RC car: actuation, teleop, sensors.</description>
  <maintainer email="you@example.com">Harsh</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>v4l-utils</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <!-- policy_node: pip install ai-edge-litert (no rosdep key) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
